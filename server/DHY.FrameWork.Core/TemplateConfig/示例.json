 let dispTable=that.getWidgetRef('dispDetailTable')\nlet stepMain=that.getWidgetRef('stepMain')\nlet tStack=that.getWidgetRef('tStack')\nlet tDisp=that.getWidgetRef('tDisp')\nlet tReCheck=that.getWidgetRef('tReCheck')\nlet stepStation=that.getWidgetRef('stepStation')\n\n//设置总步骤\n//发框：0-未知，1-空闲；2-已下发；3-发框完成；4-扫码完成；5-绑定完成\nlet unstackTask=data.unstackingTasks\nif(!unstackTask){\n  return\n}\nlet activeStep=1\nlet activeStation=1;\nif(unstackTask.status==5){\n  activeStep=2\n  activeStep=2\n}\n/*\n调剂状态：0-未知1-空闲；2-已下发；3-开始调剂；4-调剂完成；5-落药完成\n*/\nif(data.dispensingTasks.filter(s=>s.status<5).length==0){\n  activeStep=3\n  activeStation=25\n}\n/*\n复核状态：0-未知；1-空闲；2-框到达；3-复核完成\n*/\nif(data.prescriptionCheckTasks.status==3){\n  activeStep=0\n}\n//总步骤\nstepMain.setActiveStep(activeStep)\n//站台步骤\nstepStation.setActiveStep(activeStation)\n//设备调剂明细\ndispTable.setTableData(data.dispensingTasks)\n}\n\n/*\n调剂数据处理\n*/\n\nfunction parseTreeData(datas) {\n\tlet dataGroup = Object.groupBy(datas, (data) => data.prescriptionNo)\n\tlet treeDatas = []\n\tlet preTypes = ['未知', '代煎', '自煎', '膏方']\n\tlet decoctorTypes = ['未知', '先煎', '群药', '后下', '烊化', '单包']\n\tdebugger\n\tfor (var group in dataGroup) {\n\t\tlet pres = dataGroup[group]\n\t\tlet presCount = pres.length\n\t\tif (presCount == 0) {\n\t\t\tcontinue;\n\t\t}\n\t\tlet presNode = {\n\t\t\tlabel: pres[0].patientName + \"-\" + pres[0].prescriptionNo + \"[\" + preTypes[pres[0].prescriptType % 5] +\n\t\t\t\t\"]\",\n\t\t\tchildren: []\n\t\t};\n\t\tif (presCount == 1) {\n\t\t\t//无拆方\n\t\t\tlet pre = pres[0];\n\t\t\tpre.decoctionTasks.forEach(function(item, index, arr) {\n\t\t\t/*\n\t\t\t\tlet dispItems = pre.dispensingTasks.filter(s => s.taskNo == item.taskNo && s.taskIndex == item.taskIndex)\n\t\t\t\tlet medGroup = Object.groupBy(dispItems, (data) => data.code)\n\t\t\t\tlet dispGroupItems = []\n\t\t\t\tfor (var itemGroup in medGroup) {\n\t\t\t\t\tlet gItem = medGroup[itemGroup]\n\t\t\t\t\tif (gItem.length == 1) {\n\t\t\t\t\t\tdispGroupItems.push(gItem[0])\n\t\t\t\t\t} else {\n\t\t\t\t\t\tlet ggItems = gItem[0]\n\t\t\t\t\t\tggItems.children = []\n\t\t\t\t\t\tgItem.forEach(function(g, gi, ga) {\n\t\t\t\t\t\t\tggItems.children.push(g)\n\t\t\t\t\t\t})\n\t\t\t\t\t\tdispGroupItems.push(ggItems)\n\t\t\t\t\t}\n\t\t\t\t}*/\n\t\t\t\tlet node = {\n\t\t\t\t\tlabel: decoctorTypes[item.dispensingType] + \"-\" + item.taskNo + \"-\" + item.taskIndex,\n\t\t\t\t\tunstackingTasks: pre.unstackingTasks.find(s => s.taskNo == item.taskNo && s.taskIndex ==\n\t\t\t\t\t\titem.taskIndex),\n\t\t\t\t\tdispensingTasks: pre.dispensingTasks.filter(s => s.taskNo == item.taskNo && s.taskIndex == item.taskIndex),\n\t\t\t\t\tprescriptionCheckTasks: pre.prescriptionCheckTasks.find(s => s.taskNo == item.taskNo &&\n\t\t\t\t\t\ts.taskIndex == item.taskIndex),\n\t\t\t\t};\n\t\t\t\tpresNode.children.push(node);\n\t\t\t})\n\t\t} else {\n\t\t\tpres.forEach(function(pitem, pindex, parr) {\n\t\t\t\tlet cNode = {\n\t\t\t\t\tlabel: '拆方' + pitem.index,\n\t\t\t\t\tchildren: []\n\t\t\t\t}\n\t\t\t\tpitem.decoctionTasks.forEach(function(item, dindex, darr) {\n\t\t\t\t\tlet node = {\n\t\t\t\t\t\tlabel: decoctorTypes[item.dispensingType] + \"-\" + item.taskNo\n\t\t\t\t\t};\n\t\t\t\t\tcNode.children.push(node);\n\t\t\t\t})\n\t\t\t\tpresNode.children.push(cNode);\n\n\t\t\t})\n\n\t\t}\n\t\ttreeDatas.push(presNode);\n\t}\n\treturn treeDatas\n}\n","layoutType":"PC","jsonVersion":3,"dataSources":[{"dataSourceId":"ds20139","uniqueName":"prescriptionTree","requestURL":"http://101.89.143.247:84/api/prescription/allPrescription","requestURLType":"String","requestMethod":"get","description":"处方树","headers":[],"params":[],"data":[],"configHandlerCode":"  return config","dataHandlerCode":"  let datas =result.data.data||[{}];\n  return \t\tparseTreeData(datas)","errorHandlerCode":"  $message.error(error.message);","dataSetEnabled":false,"dataSets":[]}],"onFormCreated":"","onFormMounted":"","onFormDataChange":"","onFormValidate":""}}