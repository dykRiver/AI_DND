Position":"left","h5LabelTop":true,"mobileLabelPosition":"top","gridResponsive":true,"size":"","labelAlign":"label-left-align","mobileLabelAlign":"label-left-align","dashboardGridRowHeight":48,"cssCode":".content{\n  height: 95%;\n  overflow: scroll;\n}","customClass":["content"],"functions":"var mg_select = [\n  {\n    select:\"contraindication\", // 下拉框控件名称\n    guidanceType:0,\n    urlName:'matchSelect'\n  }\n  ,\n  {\n    select:\"useTime\", // 下拉框控件名称\n    guidanceType:1,\n    urlName:'matchSelect'\n  }\n  ,\n  {\n    select:\"useCount\", // 下拉框控件名称\n    guidanceType:2,\n    urlName:'matchSelect'\n  },\n  {\n    select:\"useTemperature\", // 下拉框控件名称\n    guidanceType:3,\n    urlName:'matchSelect'\n  },\n  {\n    select:\"useDosage\", // 下拉框控件名称\n    guidanceType:9,\n    urlName:'matchSelect'\n  },\n  {\n    select:\"specialUse\", // 下拉框控件名称\n    guidanceType:4,\n    urlName:'matchSelect'\n  },\n  {\n    select:\"useCourse\", // 下拉框控件名称\n    guidanceType:5,\n    urlName:'matchSelect'\n  },\n  {\n    select:\"store\", // 下拉框控件名称\n    guidanceType:6,\n    urlName:'matchSelect'\n  },\n  {\n    select:\"monitor\", // 下拉框控件名称\n    guidanceType:7,\n    urlName:'matchSelect'\n  },\n  {\n    select:\"health\", // 下拉框控件名称\n    guidanceType:[10,11,12,13],\n    urlName:'matchSelect'\n  },\n   \n  ]","layoutType":"H5","jsonVersion":3,"actionRules":[],"dataSources":[{"dataSourceId":"ds98965","uniqueName":"getMedicationGuidanceInfo","requestURL":"DSV['baseUrl']+\"/api/ContraindicationMatchRule/MedicationGuidanceInfo\"","requestURLType":"Variable","requestMethod":"post","description":"","headers":[],"params":[],"data":[{"name":"prescriptionNo","type":"Variable","value":"DSV.prescriptionNo"}],"configHandlerCode":"  return config","dataHandlerCode":"return result.data.result;","errorHandlerCode":"  $message.error(error.message);","dataSetEnabled":false,"dataSets":[]},{"dataSourceId":"ds43592","uniqueName":"appDetail","requestURL":"DSV['baseUrl']+\"/api/PrescriptionInfo/appDetail\"","requestURLType":"Variable","requestMethod":"post","description":"","headers":[],"params":[],"data":[{"name":"prescriptionNo","type":"Variable","value":"DSV.prescriptionNo"}],"configHandlerCode":"  return config","dataHandlerCode":"  return result.data.result;","errorHandlerCode":"  $message.error(error.message);","dataSetEnabled":false,"dataSets":[]}],"onFormCreated":"","onFormMounted":" \n function GetContent(res,guidanceType){\n    let data = res.filter(n=> n.guidanceType == guidanceType)\n    if(data != null && data.length > 0){\n      return data[0].content\n    }\n    return '';\n }\n \n \n  this.getFormRef().executeDataSource('getMedicationGuidanceInfo',{}).then(res => {\n   \n    for(let item of mg_select){\n      let content = ''\n      debugger\n      if(!Array.isArray(item.guidanceType)){\n          content = GetContent(res,item.guidanceType)\n      }else{\n        for(let guidanceType of item.guidanceType){\n          content += GetContent(res,guidanceType)\n        }\n      }\n      this.getWidgetRef(item.select,false).setValue(content);\n    }\n    \n  });\n  \n   this.getFormRef().executeDataSource('appDetail',{}).then(res => {\n      this.getWidgetRef('prescriptionNo',false).setValue(res.prescriptionNo);\n      this.getWidgetRef('patientName',false).setValue(res.patientName);\n      this.getWidgetRef('frequency',false).setValue(res.frequency);\n      this.getWidgetRef('takeMethod',false).setValue(res.takeMethod);\n      this.getWidgetRef('dosage',false).setValue(res.dosage);\n  });\n  ","onAfterSetFormData":"","onFormDataChange":"","onFormValidate":""}}